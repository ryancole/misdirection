{
  // arduino-cli is located by etc/common.ps1, which checks the
  // Arduino IDE 2.x install first and falls back to PATH. Deliberately
  // not duplicated here.

  "files.associations": {
    "*.ino": "cpp"
  },

  "files.exclude": {
    "**/.build": true
  },
  "search.exclude": {
    "**/.build": true
  },

  // The PL2303 cable's COM port. Serial Monitor picks this up as a
  // default; check "Arduino: List boards" if it moves.
  "serialMonitor.defaultBaudRate": 115200,
  "serialMonitor.lineEnding": "\r\n"
}
